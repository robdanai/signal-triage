# Signal Triage Environment Configuration
# Generated: 2026-01-29

# ===== Database =====
# For Docker/Production (PostgreSQL)
DATABASE_URL=postgresql://signaltriage:changeme@postgres:5432/signal_triage

# For Local Development (SQLite - uncomment below, comment above)
# DATABASE_URL=sqlite:///signal_triage.db

# PostgreSQL Password (must match DATABASE_URL)
POSTGRES_PASSWORD=changeme_use_secure_password_in_production

# ===== Cache Configuration =====
CACHE_BACKEND=file
CACHE_DIR=.cache

# ===== Market Data APIs =====
# FRED (Federal Reserve Economic Data) - Treasury Yields
# Register: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage - Stock prices, yields
# Register: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# IEX Cloud - Stock quotes, company financials
# Register: https://iexcloud.io/
IEXCLOUD_API_TOKEN=

# 9fin - Recovery rates, exit multiples (commercial)
NINEFIN_API_KEY=

# Bloomberg Terminal API (requires Terminal license)
BLOOMBERG_API_KEY=

# Credit Rating Agencies (commercial subscriptions)
SP_CAPITAL_IQ_API_KEY=
MOODYS_API_KEY=
FITCH_API_KEY=

# ===== FastAPI Application =====
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1

# API Keys (comma-separated, leave empty for development)
API_KEYS=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ===== Logging =====
LOG_LEVEL=INFO

# ===== Environment =====
ENVIRONMENT=development
DEBUG=false

# ===== SEC Configuration =====
# SEC EDGAR requires a User-Agent with contact email (SEC policy)
# Replace "your.email@example.com" with your actual email
# See: https://www.sec.gov/os/webmaster-faq
SEC_USER_AGENT=SignalTriage/1.0 (distressed.analyst@example.com)

# ===== Benchmarker =====
# Enable live market data for benchmarking (set to 1 to enable)
BENCHMARKER_USE_LIVE=1
# Data source: edgar (free, SEC filings) or stub (demo data)
BENCHMARKER_DATA_SOURCE=edgar
