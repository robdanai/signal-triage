# Docker-Specific Environment Overrides
# These values override .env when running in Docker containers

# ===== Database =====
# Use PostgreSQL container (matches docker-compose service name)
DATABASE_URL=postgresql://signaltriage:changeme@postgres:5432/signal_triage
POSTGRES_PASSWORD=changeme_use_secure_password_in_production

# ===== Cache Configuration =====
# Use Redis container (matches docker-compose service name)
CACHE_BACKEND=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ===== FastAPI Application =====
# Bind to all interfaces in Docker
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ===== Environment =====
ENVIRONMENT=docker
LOG_LEVEL=INFO

# ===== CORS =====
# Allow dashboard to connect to API
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://dashboard:8501
