# Signal Triage Environment Configuration
# Copy this file to .env and fill in your API keys

# ===== Database =====
DATABASE_URL=sqlite:///signal_triage.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/signal_triage

# ===== Cache Configuration =====
CACHE_BACKEND=file
# Options: "file" (default), "redis", "memory"

# CACHE_DIR=.cache
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# ===== Market Data APIs =====

# SEC EDGAR (no API key required)
# Free, no limits, but max 10 requests/second

# FRED (Federal Reserve Economic Data) - Treasury Yields
# Register: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage - Stock prices, yields
# Free tier: 25 calls/day, Premium: up to 1200/min
# Register: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# IEX Cloud - Stock quotes, company financials
# Commercial, pay-as-you-go pricing
# Register: https://iexcloud.io/
IEXCLOUD_API_TOKEN=

# 9fin - Recovery rates, exit multiples (commercial)
NINEFIN_API_KEY=

# Bloomberg Terminal API (requires Terminal license)
BLOOMBERG_API_KEY=

# Credit Rating Agencies (commercial subscriptions)
SP_CAPITAL_IQ_API_KEY=
MOODYS_API_KEY=
FITCH_API_KEY=

# ===== FastAPI Application =====
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# API Keys (comma-separated)
# Leave empty for open API (not recommended for production)
API_KEYS=

# CORS Origins (comma-separated)
CORS_ORIGINS=*

# ===== Logging =====
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR

# ===== Environment =====
ENVIRONMENT=development
# Options: development, staging, production

DEBUG=false

# ===== SEC Configuration =====
# SEC EDGAR requires a User-Agent with contact email (SEC policy)
# Replace "your.email@example.com" with your actual email
# See: https://www.sec.gov/os/webmaster-faq
SEC_USER_AGENT=SignalTriage/1.0 (your.email@example.com)

# ===== Benchmarker =====
# Enable live market data for benchmarking (set to 1 to enable)
BENCHMARKER_USE_LIVE=1
# Data source: edgar (free, SEC filings) or stub (demo data)
BENCHMARKER_DATA_SOURCE=edgar
